---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Path to the OG/Twitter share image, relative to site root. */
  ogImage?: string;
}

const {
  title = `${site.name} – ${site.legalName}`,
  description = site.description,
  ogImage = '/images/luka-vuksan.jpg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImageAbsolute = new URL(ogImage, site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name: site.name,
  alternateName: site.legalName,
  url: site.url,
  description: site.description,
  sport: 'Submission Grappling',
  logo: new URL('/images/adcc-retina-logo.png', site.url).href,
  areaServed: 'HR',
  sameAs: [
    'https://adcombat.com/',
    'https://www.facebook.com/adcccroatia',
  ],
};
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0c10" />
    <meta name="color-scheme" content="dark" />
    <meta name="author" content="Schetka Studio" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/adcc-retina-logo.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:locale" content={site.locale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
  </head>
  <body>
    <slot />
  </body>
</html>
