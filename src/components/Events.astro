---
import { events, links } from '../data/site';
---

<section id="tournaments" class="section tournaments">
  <div class="container">
    <div class="section-header">
      <div>
        <div class="section-tag">Kalendar &amp; Prijave</div>
        <h2 class="section-title">NADOLAZEĆI TURNIRI &amp; PRVENSTVA</h2>
      </div>
      <a href={links.smoothcomp} target="_blank" rel="noopener" class="btn-secondary">
        Smoothcomp Registracija ↗
      </a>
    </div>

    <div class="events-grid">
      {events.map((event) => (
        <article class="event-card">
          <img
            src={event.image}
            alt={event.title}
            class="event-card-img"
            width="420"
            height="220"
            loading="lazy"
          />
          <div class="event-card-body">
            <div class="event-date">{event.date}</div>
            <h3 class="event-name">{event.title}</h3>
            <p class="event-loc">{event.location}</p>
            <a
              href={event.cta.href}
              target="_blank"
              rel="noopener"
              class="event-link"
            >
              {event.cta.label}
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .events-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .event-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.2s, border-color 0.2s;
  }
  .event-card:hover {
    transform: translateY(-4px);
    border-color: var(--primary-color);
  }
  .event-card-img {
    width: 100%;
    height: 220px;
    object-fit: cover;
  }
  .event-card-body {
    padding: 24px;
  }
  .event-date {
    font-size: 12px;
    font-weight: 800;
    color: var(--primary-color);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
  }
  .event-name {
    font-size: 20px;
    font-weight: 800;
    margin-bottom: 12px;
  }
  .event-loc {
    font-size: 14px;
    color: var(--text-muted);
    margin-bottom: 20px;
    line-height: 1.5;
  }
  .event-link {
    display: inline-block;
    font-size: 13px;
    font-weight: 800;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-bottom: 2px solid var(--primary-color);
    padding-bottom: 4px;
  }
  .event-link:hover {
    color: var(--primary-color);
  }

  @media (max-width: 900px) {
    .events-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
