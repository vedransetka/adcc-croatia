---
import { site, nav, links } from '../data/site';

const year = 2026;
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <div class="brand">
          <img
            src="/images/adcc-retina-logo.png"
            alt="ADCC Submission Fighting World Federation"
            class="brand-logo"
            width="110"
            height="51"
          />
          <span class="brand-title">CROATIA</span>
        </div>
        <p class="footer-about">
          Hrvatski savez submission fightinga i službeni predstavnik ADCC
          federacije. Posvećeni razvoju grappling sporta i natjecatelja u RH.
        </p>
      </div>

      <div class="footer-col">
        <h4>Navigacija</h4>
        <ul>
          {nav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Partneri</h4>
        <ul>
          <li><a href={links.adcombat} target="_blank" rel="noopener">ADCC Global</a></li>
          <li><a href={links.smoothcomp} target="_blank" rel="noopener">Smoothcomp</a></li>
          <li><a href="https://www.hoo.hr" target="_blank" rel="noopener">Hrvatski Olimpijski Odbor</a></li>
          <li><a href={links.pixieset} target="_blank" rel="noopener">Pixieset Galerija</a></li>
          <li><a href={links.facebook} target="_blank" rel="noopener">Facebook</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Kontakt</h4>
        <ul>
          <li>Voditelj: {site.manager}</li>
          <li>Lokacija: {site.locations}</li>
          <li>Domena: {site.domain}</li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div>© {year} {site.name}. Sva prava pridržana.</div>
      <div class="schetka-badge">
        ⚡ Designed &amp; Engineered by
        <a href={links.schetka} target="_blank" rel="noopener"><strong>Schetka Studio</strong></a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-footer);
    border-top: 1px solid var(--border-subtle);
    padding-block: 60px 40px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 48px;
    margin-bottom: 48px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 16px;
  }
  .brand-logo {
    height: 42px;
    width: auto;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.4));
  }
  .brand-title {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 900;
    letter-spacing: 2px;
    line-height: 1;
    text-transform: uppercase;
  }
  .footer-about {
    font-family: var(--font-body);
    color: var(--text-muted);
    font-size: 14px;
    max-width: 320px;
    line-height: 1.6;
  }
  .footer-col h4 {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 900;
    text-transform: uppercase;
    margin-bottom: 20px;
    color: #fff;
    letter-spacing: 1.5px;
  }
  .footer-col ul {
    list-style: none;
  }
  .footer-col li {
    margin-bottom: 12px;
    font-size: 14px;
    color: var(--text-muted);
  }
  .footer-col a:hover {
    color: var(--primary-color);
  }
  .footer-bottom {
    border-top: 1px solid var(--border-subtle);
    padding-top: 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--text-muted);
  }
  .schetka-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    color: #e5e7eb;
  }
  .schetka-badge strong {
    color: #fff;
  }
  .schetka-badge a:hover strong {
    color: var(--accent-gold);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }
  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
