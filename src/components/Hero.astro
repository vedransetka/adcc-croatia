---
import { heroStats, links } from '../data/site';
---

<section class="hero" id="about">
  <div class="container hero-grid">
    <div class="hero-content">
      <span class="hero-badge">
        <img
          src="/images/adcc-croatia-crest.jpg"
          alt=""
          class="hero-badge-crest"
          width="20"
          height="20"
        />
        ADCC Croatian Submission Fighting Organization
      </span>
      <h1 class="hero-h1">
        VRHUNAC HRVATSKOG <span>SUBMISSION</span> FIGHTINGA
      </h1>
      <p class="hero-desc">
        Službeno predstavništvo najprestižnije svjetske grappling organizacije u
        Hrvatskoj. Vodimo borce putem prema ADCC svjetskoj sceni, organiziramo
        nacionalna prvenstva i otvorene kupove po strogim službenim standardima.
      </p>
      <div class="hero-buttons">
        <a href={links.smoothcomp} target="_blank" rel="noopener" class="btn-primary">
          ADCC Croatia Open 2026 Prijava ↗
        </a>
        <a href="/#tournaments" class="btn-secondary">Pregledaj Turnire</a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="hero-card">
        <img
          src="/images/fb-hero-arena.jpg"
          alt="ADCC Croatia — Dvorana Krešimir Ćosić, ŠC Višnjik Zadar"
          class="hero-img"
          width="620"
          height="380"
          fetchpriority="high"
        />
        <div class="hero-card-body">
          {heroStats.map((stat) => (
            <div class="hero-stat">
              <div class="hero-stat-num">{stat.num}</div>
              <div class="hero-stat-label">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: 110px 90px;
    background:
      linear-gradient(180deg, rgba(19, 23, 34, 0.6) 0%, rgba(10, 12, 16, 1) 100%),
      radial-gradient(circle at 80% 20%, rgba(225, 6, 0, 0.15) 0%, transparent 60%);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    align-items: center;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 16px;
    background: rgba(225, 6, 0, 0.12);
    border: 1px solid rgba(225, 6, 0, 0.4);
    color: #ff3b30;
    font-size: 11px;
    font-weight: 800;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 24px;
  }
  .hero-badge-crest {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 8px rgba(225, 6, 0, 0.4);
  }
  .hero-h1 {
    font-family: var(--font-display);
    font-size: clamp(52px, 6.5vw, 84px);
    font-weight: 900;
    line-height: 0.94;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .hero-h1 span {
    color: var(--primary-color);
    text-shadow: 0 0 35px rgba(225, 6, 0, 0.4);
  }
  .hero-desc {
    font-family: var(--font-body);
    font-size: 17px;
    color: var(--text-muted);
    max-width: 580px;
    margin-bottom: 40px;
    line-height: 1.65;
  }
  .hero-buttons {
    display: flex;
    gap: 20px;
    align-items: center;
    flex-wrap: wrap;
  }
  .hero-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
  }
  .hero-img {
    width: 100%;
    height: 380px;
    object-fit: cover;
    object-position: center 38%;
  }
  .hero-card-body {
    padding: 24px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .hero-stat-num {
    font-family: var(--font-display);
    font-size: 38px;
    font-weight: 900;
    line-height: 1;
    color: var(--accent-gold);
    letter-spacing: 0.5px;
  }
  .hero-stat-label {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--text-muted);
    text-transform: uppercase;
    margin-top: 4px;
  }

  @media (max-width: 900px) {
    .hero {
      padding-block: 56px 48px;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero-h1 {
      font-size: 38px;
    }
    .hero-desc {
      font-size: 16px;
      margin-bottom: 28px;
    }
    .hero-img {
      height: 280px;
    }
  }
</style>
