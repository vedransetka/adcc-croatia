---
import { heroStats, links } from '../data/site';
---

<section class="hero" id="about">
  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-badge">
        <img
          src="/images/adcc-croatia-logo-official.png"
          alt="ADCC Croatia Logo"
          class="hero-badge-logo"
          width="36"
          height="24"
        />
        <span class="hero-badge-text">ADCC CROATIAN SUBMISSION FIGHTING ORGANIZATION</span>
      </div>

      <h1 class="hero-h1">
        HRVATSKI GRAPPLING<br />
        <span class="hero-highlight">NA SVJETSKOJ SCENI</span>
      </h1>

      <p class="hero-desc">
        Službeno nacionalno predstavništvo najprestižnije svjetske submission fighting organizacije.
        Vodimo borce putem prema ADCC svjetskoj sceni, organiziramo nacionalna prvenstva i
        otvorene kupove po strogim međunarodnim standardima.
      </p>

      <div class="hero-buttons">
        <a href="/#tournaments" class="btn-primary hero-btn-main">
          <span>Pregledaj Turnire &amp; Rezultate</span>
        </a>
        <a href="/pravila" class="btn-secondary">
          ADCC Pravila &amp; Kriteriji →
        </a>
      </div>

      <div class="hero-trust">
        <div class="trust-item">
          <span class="trust-icon">🏆</span>
          <span>Službena ADCC Licenca</span>
        </div>
        <div class="trust-sep">•</div>
        <div class="trust-item">
          <span class="trust-icon">⏱️</span>
          <span>Pro &amp; Inter Divizije</span>
        </div>
        <div class="trust-sep">•</div>
        <div class="trust-item">
          <span class="trust-icon">🏟️</span>
          <span>ŠC Višnjik, Dvorana Krešimir Ćosić</span>
        </div>
      </div>
    </div>

    <!-- Integrated Stats Strip -->
    <div class="hero-stats-strip">
      {heroStats.map((stat) => (
        <div class="stat-cell">
          <div class="stat-num">{stat.num}</div>
          <div class="stat-label">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 84vh;
    display: flex;
    align-items: center;
    background-color: #0a0c10;
    background-image:
      linear-gradient(
        90deg,
        rgba(10, 12, 16, 0.97) 0%,
        rgba(10, 12, 16, 0.92) 45%,
        rgba(10, 12, 16, 0.65) 75%,
        rgba(10, 12, 16, 0.85) 100%
      ),
      linear-gradient(
        180deg,
        rgba(10, 12, 16, 0.75) 0%,
        transparent 20%,
        transparent 70%,
        rgba(10, 12, 16, 0.98) 100%
      ),
      radial-gradient(circle at 82% 25%, rgba(225, 6, 0, 0.22) 0%, transparent 60%),
      url('/images/fb-hero-arena.jpg');
    background-size: cover;
    background-position: center 42%;
    background-repeat: no-repeat;
    padding-block: 105px 75px;
    overflow: hidden;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 60px;
  }

  .hero-content {
    max-width: 760px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 7px 16px;
    background: rgba(10, 12, 16, 0.85);
    border: 1px solid rgba(225, 6, 0, 0.4);
    border-radius: 999px;
    color: #fca5a5;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
    margin-bottom: 26px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
  }
  .hero-badge-logo {
    height: 20px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 6px rgba(225, 6, 0, 0.5));
  }
  .hero-badge-text {
    line-height: 1;
  }

  .hero-h1 {
    font-family: var(--font-display);
    font-size: clamp(50px, 6.8vw, 88px);
    font-weight: 900;
    line-height: 0.94;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 24px;
    color: #ffffff;
  }
  .hero-highlight {
    background: linear-gradient(135deg, #ff3b30 0%, #ff523d 50%, #f59e0b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 0 40px rgba(225, 6, 0, 0.45);
    display: inline-block;
  }

  .hero-desc {
    font-family: var(--font-body);
    font-size: 17.5px;
    color: #cbd5e1;
    max-width: 640px;
    margin-bottom: 36px;
    line-height: 1.65;
  }

  .hero-buttons {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 30px;
  }
  .hero-btn-main {
    box-shadow: 0 10px 25px -4px rgba(225, 6, 0, 0.55);
    background: linear-gradient(135deg, #e10600 0%, #ff2a22 100%);
    border: none;
    padding: 14px 28px;
    font-weight: 800;
  }
  .hero-btn-main:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px -4px rgba(225, 6, 0, 0.7);
  }

  .hero-trust {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    font-family: var(--font-body);
    font-size: 12.5px;
    color: #94a3b8;
    font-weight: 600;
  }
  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .trust-icon {
    font-size: 13px;
  }
  .trust-sep {
    color: rgba(255, 255, 255, 0.25);
  }

  /* Stats Strip */
  .hero-stats-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    background: rgba(10, 12, 16, 0.85);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 20px 28px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
    max-width: 900px;
  }
  .stat-cell {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .stat-num {
    font-family: var(--font-display);
    font-size: 38px;
    font-weight: 900;
    line-height: 1;
    color: var(--accent-gold);
    letter-spacing: 0.5px;
  }
  .stat-label {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #94a3b8;
    text-transform: uppercase;
    margin-top: 4px;
  }


  @media (max-width: 960px) {
    .hero {
      min-height: auto;
      padding-block: 64px 50px;
      background-position: center center;
    }
    .hero-h1 {
      font-size: 46px;
    }
    .hero-desc {
      font-size: 16px;
    }
    .hero-stats-strip {
      gap: 16px;
      padding: 16px 20px;
    }
  }

  @media (max-width: 600px) {
    .hero-stats-strip {
      grid-template-columns: 1fr;
    }
  }
</style>