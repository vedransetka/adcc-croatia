---
import { champion, links } from '../data/site';
---

<section id="champion" class="spotlight">
  <div class="container spotlight-grid">
    <figure class="champion-img-wrap">
      <img
        src={champion.photo}
        alt={`${champion.name} — svjetski prvak u submission grapplingu`}
        class="champion-img"
        width="460"
        height="520"
        loading="lazy"
      />
      <figcaption class="champion-badge">
        <div class="badge-gold">Zlatno Odličje • Bangkok &amp; Zadar</div>
        <div class="badge-name">{champion.name.toUpperCase()}</div>
      </figcaption>
    </figure>

    <div class="champion-info">
      <div class="spotlight-meta">Svjetski Uspjeh Hrvatskog Sporta</div>
      <h2 class="spotlight-h2">
        LUKA VUKSAN – SVJETSKI PRVAK &amp; PONOS ZADARSKE ŽUPANIJE
      </h2>
      <p class="spotlight-text">
        Na Svjetskom prvenstvu u Bangkoku, zadarski borac Luka Vuksan popeo se na
        vrh svijeta osvojivši zlatno odličje za Republiku Hrvatsku u iznimno jakoj
        konkurenciji. Kao priznanje za izvanredne sportske uspjehe, proglašen je i
        najboljim sportašem Zadarske županije.
      </p>

      <div class="awards-list">
        {champion.awards.map((award) => (
          <div class="award-card">
            <div class="award-title">{award.title}</div>
            <div class="award-desc">{award.desc}</div>
          </div>
        ))}
      </div>

      <div class="press-links">
        <span>Službene objave:</span>
        <a href={links.hoo} target="_blank" rel="noopener" class="press-link">
          Hrvatski Olimpijski Odbor (HOO) ↗
        </a>
        <a href={links.zupanija} target="_blank" rel="noopener" class="press-link">
          Zadarska Županija ↗
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .spotlight {
    padding-block: 100px;
    background: var(--bg-elevated);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }
  .spotlight-grid {
    display: grid;
    grid-template-columns: 460px 1fr;
    gap: 64px;
    align-items: center;
  }
  .champion-img-wrap {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 2px solid var(--accent-gold);
    box-shadow: 0 20px 40px rgba(245, 158, 11, 0.15);
    margin: 0;
  }
  .champion-img {
    width: 100%;
    height: 520px;
    object-fit: cover;
    object-position: top center;
  }
  .champion-badge {
    position: absolute;
    inset: auto 20px 20px 20px;
    background: rgba(10, 12, 16, 0.9);
    backdrop-filter: blur(8px);
    padding: 14px 20px;
    border-radius: 10px;
    border: 1px solid rgba(245, 158, 11, 0.4);
  }
  .badge-gold {
    color: var(--accent-gold);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }
  .badge-name {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 900;
    letter-spacing: 1.5px;
    line-height: 1.1;
    text-transform: uppercase;
  }
  .spotlight-meta {
    font-family: var(--font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 2.5px;
    color: var(--accent-gold);
    font-weight: 800;
    margin-bottom: 12px;
  }
  .spotlight-h2 {
    font-family: var(--font-display);
    font-size: clamp(36px, 4.5vw, 56px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .spotlight-text {
    font-family: var(--font-body);
    font-size: 17px;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 28px;
  }
  .awards-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 36px;
  }
  .award-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    padding: 20px;
    border-radius: 12px;
  }
  .award-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 900;
    color: #fff;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .award-desc {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
  }
  .press-links {
    display: flex;
    gap: 16px;
    font-size: 14px;
    font-weight: 700;
    flex-wrap: wrap;
    align-items: center;
  }
  .press-links > span {
    color: var(--text-muted);
  }
  .press-link {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .press-link:hover {
    color: var(--accent-gold);
  }

  @media (max-width: 900px) {
    .spotlight {
      padding-block: 56px;
    }
    .spotlight-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .champion-img {
      height: 420px;
    }
    .spotlight-h2 {
      font-size: 28px;
    }
    .awards-list {
      grid-template-columns: 1fr;
    }
  }
</style>
